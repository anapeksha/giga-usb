    "environment_u32_fields": ["rcc_cr", "rcc_cfgr", "rcc_d1cfgr", "rcc_gcr", "flash_optsr_cur", "scb_ccr", "mpu_ctrl", "dwt_advance"],
    "scratch_offset": 4096,
    "scratch_size": 4096
  },
  "data": { "address": "0x24012000", "capacity": 450560 },
  "operations": { "READ": 1, "PROGRAM_SECTOR": 2, "FINALIZE_HEADER": 3 },
  "limits": { "read_max": 262144, "sector_size": 4096, "header_size": 32, "flash_size": 16777216, "write_start": "0xF00000", "write_end_exclusive": "0x1000000" },
  "states": { "running": 1, "success": 2, "error": 65535 },
  "phases": { "validation": 0, "erase": 1, "program": 2, "readback": 3, "complete": 4 },
  "errors": { "identity_sfdp": 1, "status_protection": 2, "wip_cycle_timeout": 3, "wip_poll_limit": 4, "write_enable": 5, "post_write_status": 6, "request": 7, "input_crc": 8, "first_sector_header_not_ff": 9, "header_format": 10, "header_not_erased_or_gzip_magic": 11, "erase_compare": 12, "program_compare": 13, "panic": 14, "environment": 15 },
  "crc": "CRC-32/ISO-HDLC",
  "jedec_wire_hex": "1f8901",
  "jedec_result_u32": "0x01891f",
  "wip_cycle_limit": 64000000,
  "wip_poll_limit": 2000000,
  "required_core_clock_hz": 64000000,
  "requires_exclusive_reset_halted_board": true,
  "environment_gate": {
    "before_gpio_spi": true,
    "hsidivf_semantics": "Bit 5 must be set: ST LL_RCC_HSI_IsDividerReady reports the new divider applied and ready when HSIDIVF=1; HSIDIV[4:3] must independently be zero (DIV1).",
    "hsidivf_source": "https://github.com/STMicroelectronics/stm32h7xx-hal-driver/blob/master/Inc/stm32h7xx_ll_rcc.h", 
    "register_sources": ["stm32-metapac 21.0.0: chips/stm32h747xi-cm7/pac.rs, peripherals/rcc_h7.rs, peripherals/flash_h7.rs", "firmware/m7/src/boot.rs: BCM4 bit 22 and BOOT_C2", "cortex-m 0.7.7: src/peripheral/{mod,scb,mpu,dwt}.rs"],
    "checks": [
      { "register": "RCC_CR", "address": "0x58024400", "mask": "0x0000003d", "expected": "0x00000025" },
      { "register": "RCC_CFGR", "address": "0x58024410", "mask": "0x0000003f", "expected": "0x00000000" },
      { "register": "RCC_D1CFGR", "address": "0x58024418", "mask": "0x00000fff", "expected": "0x00000000" },
      { "register": "RCC_GCR", "address": "0x580244a0", "mask": "0x00000008", "expected": "0x00000000" },
      { "register": "FLASH_OPTSR_CUR", "address": "0x5200201c", "mask": "0x00400000", "expected": "0x00000000" },
      { "register": "SCB_CCR", "address": "0xe000ed14", "mask": "0x00030000", "expected": "0x00000000" },
      { "register": "MPU_CTRL", "address": "0xe000ed94", "mask": "0xffffffff", "expected": "0x00000000" }
    ],
    "dwt_advance_read_limit": 1024,
    "dwt_advance_required": "nonzero wrapping CYCCNT delta after enabling DEMCR.TRCENA and DWT_CTRL.CYCCNTENA",
    "environment_error_has_no_spi_cleanup": true
  },
  "persistent_authorization": false
}

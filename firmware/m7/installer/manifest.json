{
  "format": "giga-usb-ram-installer",
  "abi_version": 1,
  "loader_elf": "loader.elf",
  "architecture": "thumbv7em-none-eabihf",
  "endianness": "little",
  "code": { "address": "0x24000000", "size": 65536 },
  "initial_sp": "0x20020000",
  "mailbox": {
    "address": "0x24010000",
    "input_size": 32,
    "input_u32_fields": ["magic", "version", "operation", "flash_offset", "length", "input_crc32", "reserved_zero", "reserved_zero"],
    "input_magic": "0x31494c47",
    "result_offset": 32,
    "result_size": 64,
    "result_u32_fields": ["magic", "state", "error", "phase", "progress_bytes", "jedec", "sr1", "sr2", "sr3", "data_crc32", "count", "reserved", "reserved", "reserved", "reserved", "reserved"],
    "result_magic": "0x31524c47",
    "sfdp_offset": 256,
    "sfdp_size": 256,
    "environment_offset": 512,

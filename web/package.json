{
  "name": "giga-usb-diagnostics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "check:all": "npm run check && playwright test"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@tanstack/solid-query": "^5.108.1",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/solid-virtual": "^3.13.53",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "solid-js": "^1.9.9",
    "solid-sonner": "^0.3.3",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-solid": "^0.20.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "5.1.1"
  }
